# SQLite database path (defaults to data/rentai.sqlite3)
RENTAI_DATABASE_PATH=data/rentai.sqlite3
RENTAI_API_URL=http://127.0.0.1:8001
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Owner notification email transport (read by the backend/worker only).
# Use your provider's SMTP host and app password or SMTP credential.
RENTAI_EMAIL_SMTP_HOST=
RENTAI_EMAIL_SMTP_PORT=587
RENTAI_EMAIL_SMTP_USERNAME=
RENTAI_EMAIL_SMTP_PASSWORD=
RENTAI_EMAIL_FROM=
# Use starttls for port 587 or ssl for port 465. Defaults to starttls.
RENTAI_EMAIL_SMTP_SECURITY=starttls
